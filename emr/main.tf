# ============================================================
# Data Sources
# ============================================================

data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
}

data "aws_ami" "amazon_linux" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-2023.*-x86_64"]
  }

  filter {
    name   = "state"
    values = ["available"]
  }
}

# ============================================================
# SSH Key Pair
# ============================================================

resource "aws_key_pair" "deploy_key" {
  key_name   = "${var.project_name}-deploy-key"
  public_key = file("~/.ssh/${var.project_name}-deploy-key.pub")

  # Imported from the pre-existing key pair; the AWS provider doesn't read
  # `public_key` back on import, which would otherwise show a spurious
  # forced replacement here even though the key hasn't changed.
  lifecycle {
    ignore_changes = [public_key]
  }
}

# ============================================================
# Security Groups
# ============================================================

resource "aws_security_group" "ec2" {
  name        = "${var.project_name}-ec2-sg-v2"
  description = "Security group for MedSarv per-environment EC2 instances"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTPS"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.project_name}-ec2-sg-v2"
  }
}

resource "aws_security_group" "rds" {
  name        = "${var.project_name}-rds-sg-v2"
  description = "Security group for MedSarv per-environment RDS instances"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description     = "PostgreSQL from EC2"
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.ec2.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.project_name}-rds-sg-v2"
  }
}

# ============================================================
# RDS Subnet Group
# ============================================================

resource "aws_db_subnet_group" "main" {
  name       = "${var.project_name}-db-subnet-v2"
  subnet_ids = data.aws_subnets.default.ids

  tags = {
    Name = "${var.project_name}-db-subnet-v2"
  }
}

# ============================================================
# Secrets — generated by Terraform, never typed in by hand
# ============================================================

resource "random_password" "db" {
  for_each = var.environments

  length           = 24
  special          = true
  override_special = "!#$%&*()-_=+"
}

resource "aws_secretsmanager_secret" "db_password" {
  for_each = var.environments

  name = "${var.project_name}/${each.key}/db-password"
}

resource "aws_secretsmanager_secret_version" "db_password" {
  for_each = var.environments

  secret_id     = aws_secretsmanager_secret.db_password[each.key].id
  secret_string = random_password.db[each.key].result
}

resource "random_password" "jwt_secret" {
  for_each = var.environments
  length   = 48
  special  = false
}

resource "random_password" "jwt_refresh_secret" {
  for_each = var.environments
  length   = 48
  special  = false
}

resource "aws_secretsmanager_secret" "jwt" {
  for_each = var.environments

  name = "${var.project_name}/${each.key}/jwt"
}

resource "aws_secretsmanager_secret_version" "jwt" {
  for_each = var.environments

  secret_id = aws_secretsmanager_secret.jwt[each.key].id
  secret_string = jsonencode({
    jwt_secret         = random_password.jwt_secret[each.key].result
    jwt_refresh_secret = random_password.jwt_refresh_secret[each.key].result
  })
}

# ============================================================
# EC2 instance role — lets each box read its own secrets
# without needing Terraform state or long-lived AWS keys
# ============================================================

resource "aws_iam_role" "ec2" {
  name = "${var.project_name}-ec2-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy" "ec2_secrets" {
  name = "${var.project_name}-secrets-access"
  role = aws_iam_role.ec2.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Action = ["secretsmanager:GetSecretValue"]
      Resource = concat(
        [for s in aws_secretsmanager_secret.db_password : s.arn],
        [for s in aws_secretsmanager_secret.jwt : s.arn],
      )
    }]
  })
}

resource "aws_iam_instance_profile" "ec2" {
  name = "${var.project_name}-ec2-profile"
  role = aws_iam_role.ec2.name
}

# ============================================================
# Per-Environment Resources
# ============================================================

resource "aws_db_instance" "env" {
  for_each = var.environments

  identifier     = "${var.project_name}-${each.key}-db"
  engine         = "postgres"
  engine_version = "15.17"
  instance_class = each.value.db_instance_type

  allocated_storage = 20
  storage_type      = "gp3"

  db_name  = "emr_${each.key}"
  username = "emradmin"
  password = random_password.db[each.key].result

  vpc_security_group_ids = [aws_security_group.rds.id]
  db_subnet_group_name   = aws_db_subnet_group.main.name

  backup_retention_period = each.key == "prd" ? 7 : 3
  multi_az                = each.key == "prd" ? true : false
  publicly_accessible     = false
  skip_final_snapshot     = each.key != "prd"

  # Without this, RDS defers attribute changes (including the master
  # password we just set from Secrets Manager) to the next maintenance
  # window instead of applying them now — confirmed the hard way when the
  # dev app couldn't authenticate right after this instance was adopted.
  apply_immediately = true

  final_snapshot_identifier = each.key == "prd" ? "${var.project_name}-prd-final-snapshot" : null

  tags = {
    Name        = "${var.project_name}-${each.key}-db"
    Environment = each.key
  }

  # dev/test/prd are adopted, already-running instances. AWS refuses to move
  # a DB instance to a different subnet group even within the same VPC
  # ("InvalidVPCNetworkStateFault"), so don't fight that on resources we
  # didn't create — leave them on whatever subnet group they're already on.
  lifecycle {
    ignore_changes = [db_subnet_group_name]
  }
}

resource "aws_instance" "env" {
  for_each = var.environments

  ami                    = data.aws_ami.amazon_linux.id
  instance_type          = each.value.instance_type
  key_name               = aws_key_pair.deploy_key.key_name
  vpc_security_group_ids = [aws_security_group.ec2.id]
  iam_instance_profile   = aws_iam_instance_profile.ec2.name

  user_data = templatefile("${path.module}/userdata.sh.tpl", {
    environment     = each.key
    domain          = each.value.domain
    db_host         = aws_db_instance.env[each.key].address
    db_name         = "emr_${each.key}"
    db_user         = "emradmin"
    db_password_arn = aws_secretsmanager_secret.db_password[each.key].arn
    jwt_secret_arn  = aws_secretsmanager_secret.jwt[each.key].arn
    region          = "ap-south-2"
    node_env        = each.key == "prd" ? "production" : "development"
    cors_origin     = each.key == "prd" ? "https://medsarv.com" : "https://${each.value.domain}"
  })

  root_block_device {
    volume_size = 30
    volume_type = "gp3"
  }

  tags = {
    Name        = "${var.project_name}-${each.key}"
    Environment = each.key
    Domain      = each.value.domain
  }

  # dev/test are adopted from an earlier, already-running attempt at this
  # design — don't force-replace them just because today's "most recent"
  # AMI lookup differs from whatever AMI they originally booted with.
  lifecycle {
    ignore_changes = [ami]
  }
}

resource "aws_eip" "env" {
  for_each = var.environments

  instance = aws_instance.env[each.key].id
  domain   = "vpc"

  tags = {
    Name        = "${var.project_name}-${each.key}-eip"
    Environment = each.key
  }
}
